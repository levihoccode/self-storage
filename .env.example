# Copy file này thành .env (cùng thư mục) rồi chỉnh nếu cần.
# .env KHÔNG được commit — đã bị .gitignore chặn.

# --- Postgres ---
DB_URL=jdbc:postgresql://localhost:5432/self_storage
DB_USER=self_storage
DB_PASSWORD=self_storage

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- App ---
SERVER_PORT=8080
# Gốc URL frontend — dùng dựng link trong email (vd link xác nhận đề xuất khoang)
FRONTEND_URL=http://localhost:5173

# --- JWT (Base64-encoded key, at least 32 bytes; replace for non-local use) ---
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_ACCESS_TOKEN_TTL=PT15M

# --- Password hashing (bcrypt strength = log2 rounds; OWASP recommends >= 10) ---
BCRYPT_STRENGTH=10

# --- Xác minh email + chống brute-force đăng nhập (A3a) ---
# Mã xác minh 6 số gửi qua email; login sai quá ngưỡng trả 429 (đếm trên Redis).
EMAIL_VERIFICATION_TTL=PT10M
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN=PT60S
LOGIN_RATE_LIMIT_EMAIL_MAX=5
LOGIN_RATE_LIMIT_IP_MAX=20
LOGIN_RATE_LIMIT_WINDOW=PT15M

# --- Mail (dev dùng MailHog: http://localhost:8025) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@lemar.vn

# --- Storage: Cloudinary (credential A1b cấp) ---
# Đã wire vào app từ A4: ba biến dưới để @NotBlank, thiếu là app không khởi động được.
# Mỗi người tự đăng ký tài khoản free tại cloudinary.com (không cần thẻ).
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# --- VNPay sandbox (credential A1b cấp) ---
# Đã wire vào app từ A6: bốn biến dưới để @NotBlank, thiếu là app không khởi động được.
# Mỗi người tự đăng ký tài khoản sandbox riêng — IPN URL khai theo tài khoản merchant.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay/return
VNPAY_QUERYDR_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_IPN_URL=

# --- Cổng thanh toán ---
# zalopay (mặc định) hoặc vnpay; chỉ một cổng hoạt động mỗi lúc. VNPAY_* ở trên vẫn bắt buộc
# (VnPayProperties @NotBlank) dù chạy zalopay.
PAYMENT_PROVIDER=zalopay

# --- ZaloPay (sandbox) ---
# Key sandbox lấy ở trang merchant/tài liệu ZaloPay, không commit. Callback cần URL public (ngrok).
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=
ZALOPAY_REDIRECT_URL=http://localhost:8080/api/payments/zalopay/return
