# Copy file này thành .env (cùng thư mục) rồi chỉnh nếu cần.
# .env KHÔNG được commit — đã bị .gitignore chặn.

# --- Postgres ---
DB_URL=jdbc:postgresql://localhost:5432/self_storage
DB_USER=self_storage
DB_PASSWORD=self_storage

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- App ---
SERVER_PORT=8080

# --- JWT (Base64-encoded key, at least 32 bytes; replace for non-local use) ---
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_ACCESS_TOKEN_TTL=PT15M

# --- Password hashing (bcrypt strength = log2 rounds; OWASP recommends >= 10) ---
BCRYPT_STRENGTH=10

# --- Mail (dev dùng MailHog: http://localhost:8025) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@lemar.vn

# --- Storage: Cloudinary (credential A1b cấp) ---
# Chưa wire vào app — sẽ dùng từ A4.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=

# --- VNPay sandbox (credential A1b cấp) ---
# Chưa wire vào app — sẽ dùng từ A6.
# Cách lấy TMN_CODE/HASH_SECRET và dựng IPN URL: docs/vnpay-sandbox.md
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay/return
# IPN bắt buộc HTTPS — dev local phải qua tunnel (cloudflared/ngrok), và phải khai
# lại URL này trong cấu hình merchant trên portal VNPay mỗi lần tunnel đổi domain.
VNPAY_IPN_URL=
